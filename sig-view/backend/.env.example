# Copie para .env e ajuste para o ambiente da sua rede local.

# Pasta com os arquivos .geojson/.kml/.kmz de camadas (pode ser um
# caminho de rede já montado no SO, ex: /mnt/rede/sig-view/layers)
SIGVIEW_LAYERS_DIR=./data/layers

# Banco SQLite com o índice de busca (endereço/CEP/bairro/imóvel —
# gerado por scripts/build_geocoder_index.py e scripts/indexar_camadas.py)
SIGVIEW_GEOCODER_DB=./data/geocoder.db

# Arquivo .mbtiles com o mapa de ruas (gerado por gerar_e_subir_mapa.bat).
# Se existir, o próprio SIG View serve os tiles (não precisa de Docker/
# TileServer GL nem de nenhum servidor externo).
SIGVIEW_MBTILES_PATH=./data/mapa.mbtiles

# Servidor de tiles das ruas. Por padrão usa o embutido (acima).
# type=vector  -> url aponta para um style.json (embutido, ou de um TileServer GL externo)
# type=raster  -> url é um template XYZ, ex: http://servidor:8080/tiles/{z}/{x}/{y}.png
SIGVIEW_TILE_SOURCE_URL=/tiles/style.json
SIGVIEW_TILE_SOURCE_TYPE=vector

SIGVIEW_HOST=0.0.0.0
SIGVIEW_PORT=8000
