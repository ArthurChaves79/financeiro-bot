# Copie para .env e ajuste para o ambiente da sua rede local.

# Pasta com os arquivos .geojson de camadas (pode ser um caminho de rede
# já montado no SO, ex: /mnt/rede/sig-view/layers)
SIGVIEW_LAYERS_DIR=./data/layers

# Banco SQLite com o índice de busca (gerado por scripts/build_geocoder_index.py)
SIGVIEW_GEOCODER_DB=./data/geocoder.db

# Servidor de tiles das ruas, na rede local.
# type=vector  -> url aponta para um style.json (ex: TileServer GL)
# type=raster  -> url é um template XYZ, ex: http://servidor:8080/tiles/{z}/{x}/{y}.png
SIGVIEW_TILE_SOURCE_URL=http://localhost:8080/styles/ruas-sp/style.json
SIGVIEW_TILE_SOURCE_TYPE=vector

SIGVIEW_HOST=0.0.0.0
SIGVIEW_PORT=8000
